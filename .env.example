# Variables de entorno de ejemplo.
# Copia este archivo como .env y cambia los valores antes de levantar Docker.

MYSQL_DATABASE=proyectorestaurante
MYSQL_USER=usuario_app
MYSQL_PASSWORD=cambia_esta_password
MYSQL_EXPOSED_PORT=3307
# Solo se usan al ejecutar la app fuera de Docker (docker-compose fuerza db:5432).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
SECRET_KEY=cambia_esta_clave_de_sesion
RESTAURANTE_NOMBRE=Los Bro's Restaurant
TZ=America/Mexico_City
APP_PORT=8501
